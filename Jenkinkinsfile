pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '332848642864' // replace with your account ID
        AWS_REGION = 'ap-south-1'
        ECR_REPO = 'my-ecr-repo' // replace with your ECR repo
        IMAGE_TAG = "latest"
        NEXUS_CREDENTIALS = credentials('nexus-credentials-id') // Jenkins credentials
    }

    stages {
        stage('Download Artifact from Nexus') {
            steps {
                script {
                    // Example for downloading via curl
                    sh """
                    curl -u ${NEXUS_CREDENTIALS_USR}:${NEXUS_CREDENTIALS_PSW} \
                    -O http://nexus-server/repository/maven-releases/com/example/myapp/1.0/myapp-1.0.jar
                    """
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh """
                    docker build -t ${ECR_REPO}:${IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Login to AWS ECR') {
            steps {
                script {
                    sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                    """
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    sh """
                    docker tag ${ECR_REPO}:${IMAGE_TAG} ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:${IMAGE_TAG}
                    """
                }
            }
        }
    }
}
